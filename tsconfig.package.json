{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./lib/catholic-calendar",
    "outDir": "./packages/catholic-calendar/dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "incremental": false
  },
  "include": [
    "lib/catholic-calendar/**/*.ts"
  ]
}
